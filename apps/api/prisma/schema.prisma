generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  fullName        String
  phone           String?
  role            String           @default("PARTICIPANT")
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Profile relations
  schoolMemberships SchoolMembership[]
  submissions      Submission[]
  reviews          Review[]
  certificates     Certificate[]
  bids             Bid[]
  donations        Donation[]
  auditLogs        AuditLog[]
}

model School {
  id                    String           @id @default(uuid())
  code                  String           @unique
  name                  String
  addressLine1          String
  city                  String
  state                 String
  postalCode            String
  country               String           @default("India")
  principalName         String
  principalEmail        String
  principalPhone        String
  authorizedPersonName  String
  authorizedPersonEmail String
  authorizedPersonPhone String
  expectedParticipants  Int              @default(50)
  verificationStatus    String           @default("PENDING") // PENDING, VERIFIED, REJECTED, SUSPENDED
  verificationNotes     String?
  verifiedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  memberships           SchoolMembership[]
  submissions           Submission[]
}

model SchoolMembership {
  id        String   @id @default(uuid())
  userId    String
  schoolId  String
  role      String   @default("COORDINATOR") // COORDINATOR, TEACHER
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model Competition {
  id                          String    @id @default(uuid())
  slug                        String    @unique
  title                       String
  description                 String
  animalWelfareTheme          String
  competitionType             String    @default("DRAWING")
  coverImageUrl               String?
  eligibilityRules            String?
  rules                       String?
  judgingCriteria             String?   // JSON string
  allowIndividualParticipation Boolean  @default(true)
  allowSchoolParticipation    Boolean   @default(true)
  schoolShortlistLimit        Int       @default(5)
  physicalArtworkRequired     String    @default("TOP_SHORTLISTED_ONLY")
  prizes                      String?
  regStartDate                DateTime
  regEndDate                  DateTime
  submissionStartDate         DateTime
  submissionEndDate           DateTime
  status                      String    @default("DRAFT") // DRAFT, UPCOMING, REGISTRATION_OPEN, ACTIVE, SUBMISSIONS_CLOSED, JUDGING, COMPLETED, ARCHIVED
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  submissions                 Submission[]
  certificates                Certificate[]
}

model Submission {
  id                     String    @id @default(uuid())
  submissionNumber       String    @unique
  competitionId          String
  participantId          String
  schoolId               String?
  category               String
  title                  String
  description            String?
  artistStatement        String?
  status                 String    @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, SHORTLISTED_BY_SCHOOL, FOA_SHORTLISTED, APPROVED, REJECTED
  schoolRank             Int?
  finalRank              String?
  parentConsentOnRecord  Boolean   @default(true)
  publicDisplayAllowed   Boolean   @default(true)
  auctionAllowed         Boolean   @default(true)
  reviewNotes            String?
  score                  Float?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  competition            Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant            User        @relation(fields: [participantId], references: [id], onDelete: Cascade)
  school                 School?     @relation(fields: [schoolId], references: [id])
  
  assets                 SubmissionAsset[]
  reviews                Review[]
  physicalTracking       PhysicalArtworkTracking?
  certificates           Certificate[]
  auctionListing         AuctionListing?
}

model SubmissionAsset {
  id             String     @id @default(uuid())
  submissionId   String
  assetType      String     @default("PREVIEW") // ORIGINAL_PRIVATE, WATERMARKED_PREVIEW, THUMBNAIL
  fileUrl        String
  mimeType       String     @default("image/jpeg")
  createdAt      DateTime   @default(now())

  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Review {
  id             String     @id @default(uuid())
  submissionId   String
  judgeId        String
  score          Float
  feedback       String?
  createdAt      DateTime   @default(now())

  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge          User       @relation(fields: [judgeId], references: [id], onDelete: Cascade)
}

model PhysicalArtworkTracking {
  id                 String     @id @default(uuid())
  submissionId       String     @unique
  status             String     @default("NOT_REQUIRED") // NOT_REQUIRED, REQUESTED, AWAITING_DISPATCH, DISPATCHED, RECEIVED_BY_FOA, VERIFIED
  courierService     String?
  trackingNumber     String?
  dispatchedAt       DateTime?
  receivedAt         DateTime?
  verifiedAt         DateTime?
  physicalCondition  String?
  verificationNotes  String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  submission         Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Certificate {
  id                 String     @id @default(uuid())
  certificateNumber  String     @unique
  submissionId       String?
  userId             String
  competitionId      String
  recipientName      String
  type               String     @default("PARTICIPATION") // PARTICIPATION, SCHOOL_MERIT, FINALIST, WINNER, RUNNER_UP
  awardTitle         String
  category           String?
  issueDate          DateTime   @default(now())
  verificationQrCode String
  isRevoked          Boolean    @default(false)
  createdAt          DateTime   @default(now())

  submission         Submission? @relation(fields: [submissionId], references: [id])
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition        Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}

model AuctionListing {
  id                 String     @id @default(uuid())
  submissionId       String     @unique
  title              String
  story              String
  startingPrice      Float
  currentPrice       Float
  reservePrice       Float?
  status             String     @default("ACTIVE") // UPCOMING, ACTIVE, CLOSED_SOLD, CANCELLED
  startsAt           DateTime
  endsAt             DateTime
  winningBidderId    String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  submission         Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  bids               Bid[]
}

model Bid {
  id                 String         @id @default(uuid())
  auctionId          String
  bidderId           String
  amount             Float
  createdAt          DateTime       @default(now())

  auction            AuctionListing @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder             User           @relation(fields: [bidderId], references: [id], onDelete: Cascade)
}

model Donation {
  id                   String     @id @default(uuid())
  transactionReference String     @unique
  donorId              String?
  donorName            String
  donorEmail           String
  donorPhone           String?
  amount               Float
  currency             String     @default("INR")
  purpose              String     @default("Animal Medical Rescue Fund")
  status               String     @default("COMPLETED")
  isAnonymous          Boolean    @default(false)
  createdAt            DateTime   @default(now())

  donor                User?      @relation(fields: [donorId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String
  entityId    String
  details     String?  // JSON string
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}
